# Runtime configuration template for Favlist. Copy to .env and keep it private.
ADMIN_USERNAME=admin
# Generate with the command documented in README.md; never store a plaintext password.
ADMIN_PASSWORD_HASH=
# Use a unique, randomly generated string with at least 32 characters.
SESSION_SECRET=
SESSION_COOKIE_NAME=favlist_session
SESSION_MAX_AGE_SECONDS=1209600
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Optional override. Compose safely defaults this to its fixed web proxy /32.
TRUSTED_PROXY_CIDRS=
# Host reverse proxy as seen inside the web container; one exact IP or CIDR.
TRUSTED_EDGE_PROXY=172.30.55.1
# Keep empty for the same-origin Docker deployment; use exact origins for split local development.
CORS_ALLOWED_ORIGINS=

# Optional upstream settings. Leave empty unless needed by your connection.
JM_AVS_COOKIE=
JM_PROXY=

# Docker's localhost-only ports. Change only when you understand the exposure.
WEB_PORT=8080
API_PORT=8000
DATABASE_URL=sqlite+aiosqlite:////data/favlist.db

# Optional cover allowlist. Empty derives exact hosts from pinned jmcomic==2.7.3.
COVER_ALLOWED_HOSTS=
COVER_MAX_BYTES=8388608
COVER_TOTAL_TIMEOUT_SECONDS=20
COVER_NETWORK_TIMEOUT_SECONDS=5
COVER_MAX_REDIRECTS=3
COVER_MAX_PIXELS=40000000
COVER_MAX_WIDTH=12000
COVER_MAX_HEIGHT=12000
COVER_MAX_FRAMES=1
COVER_ALLOWED_FORMATS=JPEG,PNG,WEBP

# Required only with: docker compose --profile caddy up -d
APP_DOMAIN=
